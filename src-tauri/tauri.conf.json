{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vitali",
  "version": "0.1.0",
  "identifier": "com.vitali.clinica",
  "build": {
    "beforeDevCommand": "pnpm start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist/tauri-app/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Vitali · Centro Psicológico",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "maximized": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/adjuntos/**", "$APPDATA/recursos/**", "$APPDATA/grabaciones/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
